<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Redis\Scripts\*.lua" LogicalName="CheckoutQueue.Scripts.%(Filename).lua" />
    <EmbeddedResource Include="Demo\index.html" LogicalName="CheckoutQueue.Demo.index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
  </ItemGroup>

</Project>
