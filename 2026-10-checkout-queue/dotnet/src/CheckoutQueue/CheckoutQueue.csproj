<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared by every language version of this PoC: the Lua scripts are the domain logic, the page is the demo UI. -->
    <EmbeddedResource Include="..\..\..\shared\lua\*.lua" LogicalName="CheckoutQueue.Scripts.%(Filename).lua" />
    <EmbeddedResource Include="..\..\..\shared\demo\index.html" LogicalName="CheckoutQueue.Demo.index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
  </ItemGroup>

</Project>
